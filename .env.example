# Family Portal — environment variables
#
# Copy to .env.local for development (gitignored), or run `vercel env pull`
# once the project is linked. Set the same names in the Vercel project
# (Settings → Environment Variables) for Production and Preview.

# ---- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://abidingwaycottageschool.com

# ---- Auth.js ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Vercel sets the host; this tells Auth.js to trust it.
AUTH_TRUST_HOST=true
# Comma-separated. Whoever signs in with one of these becomes an admin on first
# sign-in, even before any user rows exist. Everyone else must be added by an admin.
ADMIN_EMAILS=

# ---- Magic-link email (Resend) ------------------------------------------------
# https://resend.com → API Keys. Until the domain is verified in Resend, use
# AUTH_RESEND_FROM=onboarding@resend.dev, which only delivers to the Resend
# account owner's own address — fine for testing the first admin sign-in.
RESEND_API_KEY=
AUTH_RESEND_FROM=Abiding Way Cottage School <portal@abidingwaycottageschool.com>

# ---- Database (Neon Postgres) -------------------------------------------------
# Created from the Vercel dashboard: Storage → Create Database → Neon → connect
# to this project. Vercel injects DATABASE_URL automatically.
DATABASE_URL=

# ---- Files (Vercel Blob) ------------------------------------------------------
# Created from Storage → Create → Blob → connect to this project. Vercel injects it.
BLOB_READ_WRITE_TOKEN=
